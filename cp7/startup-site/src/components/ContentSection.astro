---
import Section from "./Section.astro";
import Button from "./Button.astro";
import type { CollectionEntry } from "astro:content";

interface Props {
  entry: CollectionEntry<"sections">;
  headingLevel?: "h1" | "h2";
  padding?: "top" | "both" | "bottom";
}

const { entry, headingLevel = "h2", padding = "top" } = Astro.props;
const data = entry.data;

// Solo renderiza entradas del tipo `content`; el resto se ignoran.
if (data.type !== "content") {
  return;
}

const { id, title, intro, meta, blocks = [] } = data;
const blockHeadingLevel = headingLevel === "h1" ? "h2" : "h3";
---

<Section
  id={id}
  heading={title}
  intro={intro}
  padding={padding}
  headingLevel={headingLevel}
>
  <div class="mt-10 max-w-[var(--measure)]">
    {meta && <p class="text-ink-faint mb-10 text-sm">{meta}</p>}
    <div class="space-y-10">
      {blocks.map((block, index) => (
        <div class:list={[index > 0 && "border-border border-t pt-10"]}>
          {block.heading &&
            (blockHeadingLevel === "h2" ? (
              <h2 class="text-2xl font-semibold">{block.heading}</h2>
            ) : (
              <h3 class="text-2xl font-semibold">{block.heading}</h3>
            ))}
          {block.paragraphs && (
            <div class="mt-3 space-y-3">
              {block.paragraphs.map((paragraph) => (
                <p class="text-ink-muted leading-relaxed">{paragraph}</p>
              ))}
            </div>
          )}
          {block.bullets && (
            <ul class="marker:text-primary mt-4 list-disc space-y-2 pl-5 leading-relaxed">
              {block.bullets.map((bullet) => (
                <li class="pl-1">{bullet}</li>
              ))}
            </ul>
          )}
          {block.links && (
            <div class="mt-6 flex flex-wrap gap-3">
              {block.links.map((link) => (
                <Button href={link.href} variant="secondary">
                  {link.label}
                </Button>
              ))}
            </div>
          )}
        </div>
      ))}
    </div>
  </div>
</Section>
