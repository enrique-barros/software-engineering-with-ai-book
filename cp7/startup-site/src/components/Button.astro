---
type Variant = "primary" | "secondary" | "ghost" | "on-primary";
type Size = "md" | "lg";

interface Props {
  href?: string;
  type?: "button" | "submit";
  variant?: Variant;
  size?: Size;
  class?: string;
}

const {
  href,
  type = "button",
  variant = "primary",
  size = "md",
  class: className,
} = Astro.props;

const base =
  "inline-flex items-center justify-center gap-2 rounded-md font-semibold transition-colors active:translate-y-px";

const variants: Record<Variant, string> = {
  primary:
    "bg-primary text-on-primary shadow-sm hover:bg-primary-hover active:bg-primary-active active:shadow-none",
  "on-primary":
    "bg-surface text-primary hover:bg-primary-muted active:bg-primary-muted active:text-primary-active",
  secondary:
    "border-border-strong border bg-surface text-ink hover:bg-surface-muted",
  ghost: "text-primary hover:bg-primary-muted active:text-primary-active",
};

const sizes: Record<Size, string> = {
  md: "h-10 px-4 text-sm",
  lg: "h-12 px-5 text-base",
};

const cls = [base, variants[variant], sizes[size], className].join(" ");
---

{href ? (
  <a href={href} class={cls}>
    <slot />
  </a>
) : (
  <button type={type} class={cls}>
    <slot />
  </button>
)}
