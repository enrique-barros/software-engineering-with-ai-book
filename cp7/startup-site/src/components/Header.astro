---
import { getEntry } from "astro:content";

const [siteEntry, navMainEntry] = await Promise.all([
  getEntry("site", "config"),
  getEntry("navMain", "config"),
]);

if (!siteEntry || !navMainEntry) {
  throw new Error("Colección 'site' o 'navMain' sin la entrada 'config'");
}

const site = siteEntry.data;
const nav = navMainEntry.data.items;
const current = Astro.url.pathname;

function isActive(href: string): boolean {
  if (href === "/") return current === "/";
  return current === href || current.startsWith(href);
}
---

<header class="border-border bg-bg sticky top-0 z-50 border-b">
  <div class="mx-auto flex h-16 w-full max-w-(--container-site) items-center justify-between gap-8 px-6">
    <a
      href="/"
      class="text-ink flex items-center gap-2.5 font-semibold transition-colors hover:text-primary"
    >
      <svg
        class="h-7 w-7 shrink-0"
        viewBox="0 0 26 26"
        fill="none"
        aria-hidden="true"
      >
        <rect width="26" height="26" rx="7" fill="var(--color-primary)" />
        <rect
          x="5.5"
          y="8.75"
          width="15"
          height="3.25"
          rx="1.625"
          fill="var(--color-bg)"
        />
        <rect
          x="8"
          y="14.75"
          width="12.5"
          height="3.25"
          rx="1.625"
          fill="var(--color-bg)"
          opacity="0.7"
        />
      </svg>
      <span class="text-lg tracking-display">{site.name}</span>
    </a>

    <!-- Menú móvil: <details> da un disclosure nativo (teclado + AT), cero JS. -->
    <details class="group relative lg:hidden">
      <summary class="border-border hover:bg-surface-muted group-open:bg-surface-muted active:bg-border/60 flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-md border transition-colors [&::-webkit-details-marker]:hidden">
        <span class="sr-only">Menú</span>
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <rect
            x="3"
            y="5.5"
            width="18"
            height="1.8"
            rx="0.9"
            fill="var(--color-ink)"
            class="transition-transform [transform-box:fill-box] [transform-origin:center] group-open:translate-y-[5.6px] group-open:rotate-45"
          />
          <rect
            x="3"
            y="11.1"
            width="12"
            height="1.8"
            rx="0.9"
            fill="var(--color-ink)"
            opacity="0.7"
            class="transition-opacity group-open:opacity-0"
          />
          <rect
            x="3"
            y="16.7"
            width="18"
            height="1.8"
            rx="0.9"
            fill="var(--color-ink)"
            class="transition-transform [transform-box:fill-box] [transform-origin:center] group-open:-translate-y-[5.6px] group-open:-rotate-45"
          />
        </svg>
      </summary>
      <ul class="border-border shadow-md bg-surface absolute right-0 top-full z-50 mt-2 w-56 rounded-lg border p-2">
        {nav.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isActive(item.href) ? "page" : undefined}
              class:list={[
                "block rounded-md px-3 py-2.5 text-sm font-medium transition-colors",
                isActive(item.href)
                  ? "bg-primary-muted text-primary"
                  : "text-ink-muted hover:bg-surface-muted hover:text-ink",
              ]}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </details>

    <!-- Nav de escritorio -->
    <ul class="hidden items-center gap-1 lg:flex">
      {nav.map((item) => (
        <li>
          <a
            href={item.href}
            aria-current={isActive(item.href) ? "page" : undefined}
            class:list={[
              "rounded-md px-3 py-2 text-sm font-medium transition-colors",
              isActive(item.href)
                ? "text-primary"
                : "text-ink-muted hover:bg-surface-muted hover:text-ink",
            ]}
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>
