---
interface Props {
  name?: string;
}

const { name } = Astro.props;

const common = "h-5 w-5 fill-none stroke-currentColor stroke-[1.5]";
---

{name === "terminal" && (
  <svg class={common} viewBox="0 0 24 24" aria-hidden="true">
    <rect x="3" y="4" width="18" height="14" rx="2" />
    <path d="M7 9l3 3-3 3" />
    <path d="M12 15h6" />
  </svg>
)}
{name === "transfer" && (
  <svg class={common} viewBox="0 0 24 24" aria-hidden="true">
    <path d="M5 12h14" />
    <path d="M15 8l4 4-4 4" />
  </svg>
)}
{name === "ledger" && (
  <svg class={common} viewBox="0 0 24 24" aria-hidden="true">
    <path d="M7 3h7l4 4v14H7z" />
    <path d="M14 3v4h4" />
    <path d="M10 11h6M10 15h6" />
  </svg>
)}
