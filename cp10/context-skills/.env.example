# ── Variables de entorno del proyecto (plantilla) ──────────────────
# Copia este archivo a `.env` (que está ignorado por Git) y rellena tus valores.
#   cp .env.example .env        (Linux/macOS)
#   Copy-Item .env.example .env (PowerShell)
# NUNCA modifiques este archivo con credenciales reales ni lo versiones.

# ── Base de datos PostgreSQL ───────────────────────────────────────
# URL de conexión consumida por psql/pg_dump (docs/skills.md §3).
# Formato: postgresql://<usuario>:<password>@<host>:<puerto>/<db>
DATABASE_URL=postgresql://app:app@localhost:5432/graph_book
# Alias documentado para el cliente SQL (usa uno de los dos).
POSTGRES_URL=postgresql://app:app@localhost:5432/graph_book

# Credenciales del contenedor `db` (docker-compose). SOLO para desarrollo local.
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=graph_book

# ── Kaggle (ingesta de datasets, data-engineer) ────────────────────
# Generadas en kaggle.com/settings -> API (obligatorias para usar Kaggle).
KAGGLE_USERNAME=tu_usuario_kaggle
KAGGLE_KEY=tu_clave_generada_en_kaggle

# ── Frontend (Vite) ────────────────────────────────────────────────
# URL de la API REST consumida por el cliente React.
VITE_API_URL=http://localhost:8000